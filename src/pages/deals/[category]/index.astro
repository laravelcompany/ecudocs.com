---
import "../../../styles/deals.css";
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AffiliateDisclosure from '../../../components/deals/AffiliateDisclosure.astro';
import ProductCard from '../../../components/deals/ProductCard.astro';
import PriceFilter from '../../../components/deals/PriceFilter.astro';
import CategoryNav from '../../../components/deals/CategoryNav.astro';
import EmptyState from '../../../components/deals/EmptyState.astro';
import { categories, detailPath } from '../../../lib/deals.js';
export function getStaticPaths() {
  return categories().map((c) => ({ params: { category: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const canonical = `https://ecudocs.com/deals/${c.slug}`;
const ld = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: c.name,
  itemListElement: c.items.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://ecudocs.com${detailPath(p)}` })),
};
---
<BaseLayout title={`${c.name} deals | ecudocs`} description={`${c.items.length} ${c.name} listings from eBay UK.`} canonicalUrl={canonical}>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<main class="deals-page"><header class="deals-hero"><div class="deals-wrap"><nav class="deals-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/deals">Deals</a><span aria-hidden="true">/</span><span aria-current="page">{c.name}</span></nav><p class="deals-eyebrow">Workshop deals</p><h1 class="deals-title">{c.name}</h1><p class="deals-intro">Compare {c.items.length} listings from eBay UK. Filter by keyword or price to find the right tool for your workshop.</p></div></header>
<div class="deals-wrap deals-content"><AffiliateDisclosure /><CategoryNav current={c.slug}/><PriceFilter /><p id="deal-results" class="deals-results" role="status" aria-live="polite">{c.items.length} listings shown</p><p id="deal-no-results" class="deals-empty" hidden>No listings match these filters. Try a different keyword or reset your filters.</p>{c.items.length===0 ? <EmptyState/> : <div class="deals-product-grid">{c.items.map((p)=><ProductCard p={p}/>)}</div>}</div></main></BaseLayout>
