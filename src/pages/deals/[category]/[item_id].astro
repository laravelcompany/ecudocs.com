---
import "../../../styles/deals.css";
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AffiliateDisclosure from '../../../components/deals/AffiliateDisclosure.astro';
import { products, itemSlug, money, dateOnly, titleCase, truncate, AFFILIATE_REL } from '../../../lib/deals.js';
export function getStaticPaths() {
  return products.map((p) => ({ params: { category: p.category, item_id: itemSlug(p.item_id) }, props: { p } }));
}
const { p } = Astro.props;
const canonical = `https://ecudocs.com/deals/${p.category}/${itemSlug(p.item_id)}`;
const ld = {
  '@context': 'https://schema.org', '@type': 'Product', name: p.title, ...(p.image_url && { image: p.image_url }), url: canonical,
  offers: { '@type': 'Offer', price: p.price, priceCurrency: p.currency, url: p.affiliate_url,
    itemCondition: /new/i.test(p.condition) ? 'https://schema.org/NewCondition' : 'https://schema.org/UsedCondition' },
};
---
<BaseLayout title={`${truncate(p.title, 60)} | ecudocs`} description={`${p.title} on eBay UK, ${money(p)} at time of export.`} canonicalUrl={canonical}>
<script type="application/ld+json" set:html={JSON.stringify(ld)}/><main class="deals-page"><header class="deals-hero"><div class="deals-wrap"><nav class="deals-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/deals">Deals</a><span aria-hidden="true">/</span><a href={`/deals/${p.category}`}>{titleCase(p.category)}</a><span aria-hidden="true">/</span><span aria-current="page">Listing</span></nav><p class="deals-eyebrow">{titleCase(p.category)}</p><h1 class="deals-title deals-title-detail" style="font-size:clamp(28px,3.3vw,46px);line-height:1.15">{p.title}</h1></div></header><div class="deals-wrap deals-content"><AffiliateDisclosure/><div class="deals-detail"><div class="deals-detail-image">{p.image_url && <img src={p.image_url} alt={p.title} width="500" height="450"/>}</div><div class="deals-detail-info"><p class="deal-condition">eBay UK listing</p><p class="detail-price">{money(p)}</p><p class="deals-muted">Price at time of export. Confirm price and availability on eBay.</p><dl><dt>Condition</dt><dd>{p.condition || 'Not stated'}</dd>{p.seller && <><dt>Seller</dt><dd>{p.seller}</dd></>}{p.location && <><dt>Location</dt><dd>{p.location}</dd></>}<dt>Last checked</dt><dd>{dateOnly(p.last_seen)}</dd></dl><a class="deals-button" href={p.affiliate_url} target="_blank" rel={AFFILIATE_REL}>Buy on eBay <span aria-hidden="true">↗</span><span class="sr-only">(opens in new tab)</span></a>{p.item_url && <p class="deals-plain"><a href={p.item_url} target="_blank" rel="nofollow noopener">Plain listing link</a></p>}<p class="deals-muted" style="font-size:12px;margin-top:20px">Review compatibility, seller information and delivery details before purchasing.</p></div></div></div></main></BaseLayout>
