---
import { detailPath, truncate, money, AFFILIATE_REL } from '../../lib/deals.js';
const { p } = Astro.props;
---
<article class="deal-card" data-title={p.title.toLowerCase()} data-price={p.price} style="border:1px solid #ddd;border-radius:8px;padding:1rem;display:flex;flex-direction:column;gap:.5rem">
  {p.image_url && <img src={p.image_url} alt={p.title} loading="lazy" width="200" height="200" style="object-fit:contain;max-width:100%;height:200px" />}
  <h3 style="font-size:1rem;margin:0"><a href={detailPath(p)}>{truncate(p.title)}</a></h3>
  <p style="margin:0"><strong>{money(p)}</strong> <small>at time of export</small></p>
  <p style="margin:0;font-size:.85rem">{p.condition}{p.seller && ` · ${p.seller}`}</p>
  <a href={p.affiliate_url} target="_blank" rel={AFFILIATE_REL} style="font-weight:600">View on eBay</a>
</article>
