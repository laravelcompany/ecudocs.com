---
import { detailPath, truncate, money, AFFILIATE_REL } from '../../lib/deals.js';
const { p } = Astro.props;
---
<article class="deal-card" data-title={p.title.toLowerCase()} data-price={p.price}>
<a class="deal-image" href={detailPath(p)} aria-label={`View ${p.title}`} tabindex="-1">{p.image_url && <img src={p.image_url} alt={p.title} loading="lazy" width="240" height="200" />}</a>
<div class="deal-card-body"><p class="deal-condition">{p.condition || 'Condition not stated'}</p><h3><a href={detailPath(p)}>{truncate(p.title)}</a></h3>
<p class="deal-card-price"><strong>{money(p)}</strong><small>Price at time of export</small></p>{p.seller && <p class="deal-seller">Seller: {p.seller}</p>}<a class="deals-button" href={p.affiliate_url} target="_blank" rel={AFFILIATE_REL}>View on eBay <span aria-hidden="true">↗</span><span class="sr-only">(opens in new tab)</span></a></div></article>
