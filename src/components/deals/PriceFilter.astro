<form class="price-filter" onsubmit="return false" style="display:flex;gap:.5rem;flex-wrap:wrap;margin:1rem 0">
  <input id="deal-q" type="search" placeholder="Search keyword" aria-label="Search keyword" />
  <input id="deal-min" type="number" min="0" step="0.01" placeholder="Min £" aria-label="Minimum price" />
  <input id="deal-max" type="number" min="0" step="0.01" placeholder="Max £" aria-label="Maximum price" />
</form>
<script is:inline>
  (function () {
    var q = document.getElementById('deal-q'), mn = document.getElementById('deal-min'), mx = document.getElementById('deal-max');
    function run() {
      var t = q.value.toLowerCase(), lo = parseFloat(mn.value), hi = parseFloat(mx.value);
      document.querySelectorAll('.deal-card').forEach(function (c) {
        var p = parseFloat(c.dataset.price);
        var ok = (!t || c.dataset.title.indexOf(t) > -1) && (isNaN(lo) || p >= lo) && (isNaN(hi) || p <= hi);
        c.style.display = ok ? '' : 'none';
      });
    }
    [q, mn, mx].forEach(function (e) { e.addEventListener('input', run); });
  })();
</script>
