---
import { categories } from '../../lib/deals.js';
const { current } = Astro.props;
---
<nav class="deals-categories" aria-label="Deal categories"><a href="/deals">All deals</a>{categories().map((c) => <a href={`/deals/${c.slug}`} aria-current={current === c.slug ? 'page' : undefined}>{c.name} <span>({c.items.length})</span></a>)}</nav>
