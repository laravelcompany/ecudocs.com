{
  "name": "ecudocs-com",
  "compatibility_date": "2026-03-25",
  "main": "src/worker.js",
  "pages_build_output_dir": "./dist",
  "routes": ["ecudocs.com/*"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "BLOG_KV",
      "id": "BLOG_KV_NAMESPACE_ID"
    }
  ]
}
